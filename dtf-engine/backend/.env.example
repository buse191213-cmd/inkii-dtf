# ── DTF-Engine Ayarları ──────────────────────────────────
# Bu dosyayı ".env" olarak kopyala ve kendi anahtarlarını gir.
# Hiçbir şey ayarlamazsan her adım "demo" modunda çalışır
# (akışı görürsün ama gerçek AI işlemi yapılmaz).

PORT=4000

# ── Arka plan kaldırma ───────────────────────────────────
# Seçenekler: removebg | photoroom | local | demo
BG_PROVIDER=demo
REMOVEBG_API_KEY=
PHOTOROOM_API_KEY=

# ── Çözünürlük yükseltme ─────────────────────────────────
# Seçenekler: replicate | local | demo
UPSCALE_PROVIDER=demo
REPLICATE_API_TOKEN=

# ── Vektörleştirme ───────────────────────────────────────
# Seçenekler: local | demo
VECTOR_PROVIDER=demo
